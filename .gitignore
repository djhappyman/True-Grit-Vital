app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Widget Preview related
.widget_preview/

# Host-local tool roots and regenerable native output.
android/local.properties
linux/flutter/ephemeral/
# Keep local implementation/discovery trackers; do not ignore .scratch/.

# Regenerable local structural index.
/.codebase-memory/

# Keep locally testable bundles on disk without committing compiled artifacts.
/output/linux/
/output/implementation/

